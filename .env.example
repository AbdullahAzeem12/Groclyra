# ==============================================================================
# GROCLYRA - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or configure in Firebase Secret Manager / CI-CD pipeline.
# NEVER commit production keys, service accounts, or merchant secrets to Git.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. FIREBASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=groclyra-prod
FIREBASE_STORAGE_BUCKET=groclyra-prod.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-fcm-sender-id
FIREBASE_APP_ID_ANDROID=1:1234567890:android:abcdef123456
FIREBASE_APP_ID_IOS=1:1234567890:ios:abcdef123456
FIREBASE_API_KEY=your-client-firebase-api-key

# ──────────────────────────────────────────────────────────────────────────────
# 2. GEOSPATIAL & MAPS PROVIDERS (PAKISTAN COVERAGE)
# ──────────────────────────────────────────────────────────────────────────────
# Google Maps Platform (Android & iOS SDK + Places API + Geocoding API)
GOOGLE_MAPS_API_KEY_ANDROID=AIzaSyYourAndroidRestrictedKey
GOOGLE_MAPS_API_KEY_IOS=AIzaSyYourIOSRestrictedKey
GOOGLE_MAPS_WEB_KEY=AIzaSyYourWebRestrictedKey

# Mapbox Access Token (Optional secondary map renderer & vector tiles)
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZ3JvY2x5cmEiLCJhIjoiY2x...

# ──────────────────────────────────────────────────────────────────────────────
# 3. AI CUSTOMER SUPPORT AGENT (CLOUD FUNCTIONS BACKEND)
# ──────────────────────────────────────────────────────────────────────────────
# Store in Firebase Cloud Functions Secret Manager:
# firebase functions:secrets:set GEMINI_API_KEY
# or firebase functions:secrets:set OPENAI_API_KEY
GEMINI_API_KEY=your-google-gemini-api-key-for-support-agent
OPENAI_API_KEY=your-openai-api-key-optional-fallback
AI_SUPPORT_MODEL=gemini-1.5-flash

# ──────────────────────────────────────────────────────────────────────────────
# 4. PAYMENT GATEWAY CREDENTIALS (PAKISTAN DOMESTIC CHANNELS)
# ──────────────────────────────────────────────────────────────────────────────
# JazzCash Payment Gateway (Sandbox / Production)
JAZZCASH_MERCHANT_ID=MC12345
JAZZCASH_PASSWORD=your_jazzcash_password
JAZZCASH_INTEGRITY_SALT=your_jazzcash_salt
JAZZCASH_RETURN_URL=https://groclyra.pk/api/payments/jazzcash/callback

# Easypaisa Direct Merchant API
EASYPAISA_STORE_ID=12345
EASYPAISA_HASH_KEY=your_easypaisa_aes_key
EASYPAISA_RETURN_URL=https://groclyra.pk/api/payments/easypaisa/callback

# PayFast (APPS) Debit/Credit Card Gateway
PAYFAST_MERCHANT_ID=1000
PAYFAST_SECURED_KEY=your_payfast_secured_key
PAYFAST_SANDBOX_MODE=true

# ──────────────────────────────────────────────────────────────────────────────
# 5. SMS GATEWAY FOR PHONE OTP (PAKISTAN NETWORKS: Jazz, Zong, Telenor, Ufone)
# ──────────────────────────────────────────────────────────────────────────────
SMS_GATEWAY_PROVIDER=veevotech # or twilio / telenor-direct
SMS_GATEWAY_API_KEY=your_sms_gateway_key
SMS_SENDER_MASK=Groclyra
